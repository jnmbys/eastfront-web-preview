{
  "name": "eastfront-digital-core",
  "version": "0.2.25",
  "private": true,
  "type": "module",
  "description": "UI-agnostic deterministic rules core for Eastfront Assault / 东线突击",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke": "tsc -p tsconfig.json && node scripts/smoke.mjs",
    "smoke:hardening": "tsc -p tsconfig.json && node scripts/hardening-smoke.mjs",
    "smoke:transaction": "tsc -p tsconfig.json && node scripts/transaction-integrity-smoke.mjs",
    "smoke:foundation": "tsc -p tsconfig.json && node scripts/foundation-finalization-smoke.mjs",
    "smoke:combat-declare": "tsc -p tsconfig.json && node scripts/combat-declare-smoke.mjs",
    "smoke:combat-loss": "tsc -p tsconfig.json && node scripts/combat-loss-smoke.mjs",
    "smoke:retreat-legality": "tsc -p tsconfig.json && node scripts/retreat-legality-smoke.mjs",
    "smoke:combat-retreat": "tsc -p tsconfig.json && node scripts/combat-retreat-smoke.mjs",
    "smoke:combat-advance": "tsc -p tsconfig.json && node scripts/combat-advance-smoke.mjs",
    "smoke:combat-breakthrough": "tsc -p tsconfig.json && node scripts/combat-breakthrough-smoke.mjs",
    "smoke:combat-schwerpunkt": "tsc -p tsconfig.json && node scripts/combat-schwerpunkt-smoke.mjs",
    "smoke:rail-network": "tsc -p tsconfig.json && node scripts/rail-network-smoke.mjs",
    "smoke:german-supply": "tsc -p tsconfig.json && node scripts/german-supply-smoke.mjs",
    "smoke:german-supply-refresh": "tsc -p tsconfig.json && node scripts/german-supply-refresh-smoke.mjs",
    "smoke:rail-repair": "tsc -p tsconfig.json && node scripts/rail-repair-smoke.mjs",
    "smoke:soviet-rail-network": "tsc -p tsconfig.json && node scripts/soviet-rail-network-smoke.mjs",
    "smoke:soviet-east-supply": "tsc -p tsconfig.json && node scripts/soviet-east-supply-smoke.mjs",
    "smoke:soviet-full-supply": "tsc -p tsconfig.json && node scripts/soviet-full-supply-smoke.mjs",
    "smoke:soviet-supply-refresh": "tsc -p tsconfig.json && node scripts/soviet-supply-refresh-smoke.mjs",
    "smoke:recovery": "tsc -p tsconfig.json && node scripts/recovery-smoke.mjs",
    "smoke:reinforcement-availability": "tsc -p tsconfig.json && node scripts/reinforcement-availability-smoke.mjs",
    "smoke:reinforcement-deployment": "tsc -p tsconfig.json && node scripts/reinforcement-deployment-smoke.mjs",
    "smoke:victory-evaluation": "tsc -p tsconfig.json && node scripts/victory-evaluation-smoke.mjs",
    "smoke:victory-lifecycle": "tsc -p tsconfig.json && node scripts/victory-lifecycle-smoke.mjs",
    "smoke:headless-full-game": "tsc -p tsconfig.json && node scripts/headless-full-game-smoke.mjs",
    "smoke:initial-deployment": "tsc -p tsconfig.json && node scripts/initial-deployment-smoke.mjs",
    "smoke:production-startup": "tsc -p tsconfig.json && node scripts/production-scenario-startup-smoke.mjs",
    "smoke:production-full-game": "tsc -p tsconfig.json && node scripts/production-full-game-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
