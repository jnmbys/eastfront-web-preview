  "turn_limit": 16,
  "map_revision": "Strategic Reset Candidate F — Open Operational Basin",
  "new_terrain": {
    "lake": {
      "movement": "impassable",
      "combat": "no unit may enter"
    },
    "rough": {
      "movement_cost": 2,
      "combat_shift": 0,
      "note": "Restricted ground: slows off-road movement but gives no combat column shift."
    }
  },
  "strategic_hubs": {
    "frontline": "D10",
    "northwest_gate": "J6",
    "southwest_gate": "M15",
    "mid": "R10",
    "north_hub": "V5",
    "south_hub": "X14",
    "capital": [
      "AC10",
