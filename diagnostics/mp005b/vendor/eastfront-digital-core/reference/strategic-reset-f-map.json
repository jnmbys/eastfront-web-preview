    ],
    "outer": "AD10"
  },
  "east_supply_exits": [
    "AF4",
    "AF10",
    "AF16"
  ],
  "design_notes": [
    "AC4 and AC17 moved inward to W4 and W16 as real rail/bridge hubs.",
    "One small impassable lake district creates a northern route split without adding a complex subsystem.",
    "Three west-east rail axes remain, but east-side diagonal redundancy makes flank hubs strategically meaningful.",
    "Road network is intentionally sparser than rail network so all-road 8-hex German supply remains valuable rather than automatic.",
    "Capital remains AC10+AC11; no VP system added."
  ],
  "bridge_count": 8,
  "stacking_rule": "Maximum 2 total units per hex.",
  "road_rules_candidate": {
    "road_edge_movement": "1 MP across a road-connected edge, ignoring terrain movement penalties.",
    "road_march": "If the entire movement follows continuous roads and the unit never enters enemy ZOC, +1 MP for that move.",
    "road_bridge": "Road bridge removes the river's extra movement cost; river combat penalty remains.",
    "supply_bonus_removed": true
  },
  "design_notes_B": [
    "Important hubs are surrounded by open shoulders because a hex now holds only 2 total units.",
    "Each northern/central/southern eastern approach has a road crossing separate from the rail crossing, preventing a single two-unit bridge stack from freezing an entire sector.",
    "W4 and W16 remain rail hubs, but a road bypass exists: attacker may bypass the city for speed while sacrificing rail continuity and a safe supply base.",
    "Road network is intentionally sparse because roads now directly improve movement.",
    "Lake remains the only added terrain type and creates a route fork without adding a new combat modifier.",
    "Capital still requires AC10+AC11; no VP system."
  ],
  "bridge_summary": {
    "all_transport_bridge_edges": 16,
    "road_bridge_edges": 10,
    "rail_bridge_edges": 8
  },
  "design_notes_C": [
    "Cities are staggered rather than aligned into north/center/south rows.",
    "Q9 is a natural MID pivot: controlling it shortens rotation toward either V5 or W14 without making it a victory objective.",
    "North and south fronts overlap through diagonal rail/road connectors, so reserves can rotate between sectors.",
    "V5 and W14 work like operational A/B sites: distinct local objectives with shared approaches and late-game rotation routes.",
    "Road count is deliberately reduced because road movement is now powerful (1 MP per road-connected edge, ignoring terrain movement penalties).",
    "No new VP system and no new terrain subsystem beyond the existing small lake."
  ],
  "network_stats": {
    "road_edges": 60,
    "rail_edges": 132,
    "transport_bridge_edges": 6,
    "road_bridge_edges": 2,
    "rail_bridge_edges": 6
  },
  "design_notes_E": [
    "Uses military-terrain logic: broad avenues of approach are composed of mutually supporting mobility corridors with lateral routes.",
    "Six non-capital cities are staggered and spaced; no horizontal city rows.",
    "D10 restores an early frontline objective.",
    "R10 acts as MID but is not a mandatory single choke because direct north/south rail bypasses exist.",
    "V5 and X14 act like operational A/B sites: they can be reinforced through MID or bypass routes and both feed the capital approach.",
    "Roads are intentionally sparse because roads now directly reduce movement cost.",
    "Terrain complexity comes from broken forest belts, oblique ridges, floodplain marsh, rough ground, and a compact lake—not from adding many new combat modifiers."
  ],
  "design_notes_F": [
    "Central terrain density is reduced to create a broad maneuver basin around R10.",
    "Complex terrain is moved to the basin shoulders instead of filling every central hex.",
    "Two crossing maneuver lanes meet near R10, encouraging armor maneuver, encirclement and reserve rotation.",
    "Flanks remain terrain-rich, so bypassing the middle is possible but slower and more positional.",
    "City layout, sparse road network, interlocking rail network, 2-unit stacking and the new road movement rules remain unchanged from Candidate E."
  ],
  "terrain_density_compare": {
    "candidate_E": {
